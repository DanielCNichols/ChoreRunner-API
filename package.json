{
  "name": "Chorerunner-API",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "debug": "nodemon --inspect src/server.js",
    "docs": "jsdoc -c jsdoc.conf.json",
    "migrate": "postgrator --config postgrator-config.js",
    "migrate:production": "env SSL=true DATABASE_URL=$(heroku config:get DATABASE_URL) yarn run migrate",
    "migrate:test": "cross-env NODE_ENV=test && yarn run migrate",
    "test": "mocha --require test/setup.js",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "predeploy": "yarn audit && yarn run migrate:production",
    "deploy": "git push heroku master",
    "prepare": "husky"
  },
  "keywords": [],
  "engines": {
    "node": "20.11.1"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cli": "^1.0.1",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^8.1.0",
    "express": "^4.17.1",
    "helmet": "^3.21.1",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "morgan": "^1.9.1",
    "pg": "^8.3.3",
    "postgrator": "^3.10.2",
    "postgrator-cli": "^3.3.0",
    "shortid": "^2.2.15",
    "xss": "^1.0.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.2.1",
    "@commitlint/config-conventional": "^19.1.0",
    "chai": "^4.2.0",
    "husky": "^9.0.11",
    "mocha": "^10.4.0",
    "nodemon": "^3.1.0",
    "supertest": "^4.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
