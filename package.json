{
  "name": "Chorerunner-API",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "bin": {
    "cdkapp": "bin/cdkapp.js"
  },
  "scripts": {
    "debug": "nodemon --inspect src/server.js",
    "docs": "jsdoc -c jsdoc.conf.json",
    "migrate": "postgrator --config postgrator-config.js",
    "migrate:production": "env SSL=true DATABASE_URL=$(heroku config:get DATABASE_URL) yarn run migrate",
    "migrate:test": "cross-env NODE_ENV=test && yarn run migrate",
    "test": "ts-mocha test/*ts --require test/setup.js",
    "start": "node src/server.ts",
    "build-dev": "nodemon --watch ./src/**/*.ts ./scripts/esbuild.build.mjs",
    "synth": "wait-on ./dist && cdk synth --no-staging > https://www.npmjs.com/package/wait-ontemplate.yml",
    "start-api": "sam local start-api",
    "dev": "concurrently -n \"ESBUILD,SAM\" \"yarn build-dev\" \"yarn synth && yarn start-api\"",
    "predeploy": "yarn audit && yarn run migrate:production",
    "deploy": "git push heroku master",
    "prepare": "husky",
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk"
  },
  "keywords": [],
  "engines": {
    "node": "20.11.1"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "aws-cdk-lib": "2.139.0",
    "bcryptjs": "^2.4.3",
    "cli": "^1.0.1",
    "constructs": "^10.0.0",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^8.1.0",
    "express": "^4.17.1",
    "helmet": "^3.21.1",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "morgan": "^1.9.1",
    "pg": "^8.3.3",
    "postgrator": "^3.10.2",
    "postgrator-cli": "^3.3.0",
    "shortid": "^2.2.15",
    "source-map-support": "^0.5.21",
    "xss": "^1.0.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.2.1",
    "@commitlint/config-conventional": "^19.1.0",
    "@eslint/js": "^9.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/chai": "^4.3.14",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/helmet": "^4.0.0",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/mocha": "^10.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "20.12.7",
    "@types/supertest": "^6.0.2",
    "aws-cdk": "2.139.0",
    "chai": "^4.2.0",
    "concurrently": "^8.2.2",
    "esbuild": "^0.21.5",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "mocha": "^10.4.0",
    "nodemon": "^3.1.0",
    "supertest": "^4.0.2",
    "ts-jest": "^29.1.2",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.4.5",
    "typescript-eslint": "^7.6.0",
    "wait-on": "^7.2.0"
  }
}
